#!name=Duolingo Max 解锁
#!desc=解锁 Duolingo Max 会员
#!author=Takagivegeta
#!icon=https://d35aaqx5ub95lt.cloudfront.net/images/duolingo-touch-icon2.png

[MITM]
hostname = ios-api-*.duolingo.com, ios-api-*.duolingo.cn, api*.duolingo.com, api*.duolingo.cn

[Script]
response if ${url} ~= /^https?:\/\/(ios-api-[a-z0-9-]+|api\d+)\.duolingo\.c(n|om)\/2023-05-23\/(batch|users\/[^\/?#]+)(?:[?#]|$)/i then script("https://raw.githubusercontent.com/tomopte/Loon/main/Plugins/lingoDuo-xaM.js") with tag="duolingo_max", timeout=120, requires_body=true
