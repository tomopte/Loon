[MITM]
hostname = ios-api-*.duolingo.com, ios-api-*.duolingo.cn, api*.duolingo.com, api*.duolingo.cn

[Script]
http-response ^https?:\/\/(ios-api-[a-z0-9-]+|api\d+)\.duolingo\.c(n|om)\/2023-05-23\/(batch|users\/[^\/?#]+)(?:[?#]|$) script-path=https://raw.githubusercontent.com/tomopte/Loon/main/Plugins/lingoDuo-xaM.js, requires-body=true, timeout=120, tag=duolingo_max
